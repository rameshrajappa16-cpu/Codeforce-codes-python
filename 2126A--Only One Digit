#inputs and outputs are at the bottom
import sys

def solve():
    input = sys.stdin.read
    data = input().split()
    
    t = int(data[0])
    results = []
    
    for i in range(1, t + 1):
        x_str = data[i]
        
        if '0' in x_str:
            results.append("0")
        else:
            # Get the minimum digit character
            results.append(min(x_str))
            
    print("\n".join(results))

if __name__ == '__main__':
    solve()

