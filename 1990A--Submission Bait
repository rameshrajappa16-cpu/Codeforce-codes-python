#inputs and outputs are at the bottom
import sys
from collections import Counter

def solve():
    input_data = sys.stdin.read().split()
    if not input_data:
        return
        
    t = int(input_data[0])
    idx = 1
    
    out = []
    for _ in range(t):
        n = int(input_data[idx])
        arr = [int(x) for x in input_data[idx+1 : idx+1+n]]
        idx += 1 + n
        
        counts = Counter(arr)
        
        # If any element appears an odd number of times, Alice wins
        alice_wins = False
        for count in counts.values():
            if count % 2 != 0:
                alice_wins = True
                break
                
        if alice_wins:
            out.append("YES")
        else:
            out.append("NO")
            
    print("\n".join(out))

if __name__ == '__main__':
    solve()

