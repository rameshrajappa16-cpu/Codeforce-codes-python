#inputs and outputs are at the bottom
import sys

def solve():
    input_data = sys.stdin.read().split()
    if not input_data:
        return
        
    n = int(input_data[0])
    arr = [int(x) for x in input_data[1 : 1+n]]
    
    # Compress consecutive elements into block lengths
    blocks = []
    current_count = 1
    
    for i in range(1, n):
        if arr[i] == arr[i - 1]:
            current_count += 1
        else:
            blocks.append(current_count)
            current_count = 1
    blocks.append(current_count)
    
    # Find the maximum balanced segment between any two consecutive blocks
    max_len = 0
    for i in range(len(blocks) - 1):
        possible_len = 2 * min(blocks[i], blocks[i + 1])
        if possible_len > max_len:
            max_len = possible_len
            
    print(max_len)

if __name__ == '__main__':
    solve()

